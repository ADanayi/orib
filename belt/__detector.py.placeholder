import os
import sys
sys.path.insert(0, os.path.dirname(__file__))

from BELT.detector import Detector

# ---------- Parameters from UI ----------
DETECTOR_PARAMS = {
    "downscale_factor": {{downscale_factor}},
    "filters_per_channel": {{filters_per_channel}},
    "spatial_filters": {{spatial_filters}},
    "ntb_factor": {{ntb_factor}},
    "input_shape": ({{input_shape_samples}}, {{input_shape_channels}}),
    "num_classes": {{num_classes}},
    "learning_rate": {{learning_rate}},
    "ntb_file": {{ntb_file_path}},
}

# Create detector instance
detector = Detector(**DETECTOR_PARAMS)

if __name__ == "__main__":
    detector.model.summary()
    print(f"Model width: {detector.model_width}")